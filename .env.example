# Local development environment (P02.04.03).
#
# Copy to `.env` and adjust. `.env` and every `.env.*` are gitignored except this file.
#
# EVERY VALUE HERE IS A FAKE. Nothing in this file is, or may become, a real credential.
# Real secrets live in AWS Secrets Manager and are referenced by ARN (INV-15): the application
# receives a reference, resolves it at startup, and never reads a secret from a database row, a
# configuration file or a log line.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
SERVICE_NAME=moin
# api | voice | worker | migrate — chosen by the start command; one image serves all four (INV-17)
SERVER_ROLE=api
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true
SHUTDOWN_GRACE_MS=15000

# ---------------------------------------------------------------- datastores
# The application connects as moin_app: NOBYPASSRLS and owns no tables, exactly as in production,
# so a missing row-level-security policy fails locally instead of in staging (INV-01).
DATABASE_URL=postgres://moin_app:local-development-only@127.0.0.1:5432/moin
# Migrations run as a separate role that is the only one permitted to run DDL.
DATABASE_MIGRATION_URL=postgres://moin_migrator:local-development-only@127.0.0.1:5432/moin
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------- local emulators
# Adobe S3Mock (ADR-0035). Production is real AWS S3; only the endpoint differs.
S3_ENDPOINT=http://127.0.0.1:9090
S3_FORCE_PATH_STYLE=true
S3_REGION=eu-central-1
S3_BUCKET_UPLOADS=moin-local-uploads
S3_BUCKET_RECORDINGS=moin-local-recordings
S3_BUCKET_EXPORTS=moin-local-exports
S3_ACCESS_KEY_ID=local-development-only
S3_SECRET_ACCESS_KEY=local-development-only

# ElasticMQ speaks the SQS API, including FIFO and visibility timeouts.
SQS_ENDPOINT=http://127.0.0.1:9324
SQS_REGION=eu-central-1
SQS_QUEUE_OUTBOX=moin-outbox
SQS_QUEUE_JOBS=moin-jobs
SQS_QUEUE_CONVERSATION=moin-conversation.fifo

# Mailpit catches every outbound mail, so a development run can never reach a real inbox.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@moin.localhost
MAILPIT_UI=http://127.0.0.1:8025

# Keycloak as a local OIDC provider (ADR-0036). Production identity is Amazon Cognito.
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/moin-local
OIDC_CLIENT_ID=moin-web
OIDC_CLIENT_SECRET=local-development-only
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ---------------------------------------------------------------- integration tests
# Both are required by `pnpm test:integration`. They lived only in the CI workflow, so a developer
# had to read that workflow to discover them.
#
# The ADMIN connection creates and drops the per-file test databases. The APP connection is what
# the tests themselves use, and it must be the NOBYPASSRLS application role: an admin connection
# silently bypasses row-level security, which would make every isolation test meaningless.
TEST_DATABASE_ADMIN_URL=postgres://moin_owner:local-development-only@127.0.0.1:5432/postgres
TEST_DATABASE_APP_URL=postgres://moin_app:local-development-only@127.0.0.1:5432/postgres

# ---------------------------------------------------------------- brand (ADR-0034)
# The product name is configuration, never a literal, so a rename is not a code migration.
NEXT_PUBLIC_BRAND_NAME=KlarDesk

# ---------------------------------------------------------------- external providers
# Left empty on purpose. Each integration is built against its port with a test adapter and
# recorded contract fixtures, so development does not wait on an account. Live verification of
# each stays WAITING_FOR_EXTERNAL until the founder supplies real credentials, and then the value
# is a Secrets Manager ARN rather than the secret itself.
#
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN_SECRET_ARN=
# OPENAI_API_KEY_SECRET_ARN=
# STRIPE_SECRET_KEY_SECRET_ARN=
# STRIPE_WEBHOOK_SECRET_ARN=
# GOOGLE_OAUTH_CLIENT_SECRET_ARN=
# MICROSOFT_GRAPH_CLIENT_SECRET_ARN=
