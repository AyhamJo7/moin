{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Edit",
      "Write",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(docker *)",
      "Bash(psql *)",
      "Bash(pg_isready *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform init -backend=false *)",
      "Bash(tflint *)",
      "Bash(gitleaks *)",
      "Bash(shellcheck *)",
      "Bash(lefthook *)",
      "Bash(jq *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(fdfind *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(du *)",
      "Bash(curl *)",
      "Bash(verify-head *)",
      "Bash(merge-train *)"
    ],
    "ask": [],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(!.env.example)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(//mnt/c/Users/*/.aws/**)",
      "Read(//mnt/c/Users/*/.azure/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Edit(/BLUEPRINT.md)",
      "Write(/BLUEPRINT.md)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform state *)",
      "Bash(terraform plan *)",
      "Bash(terraform plan)",
      "Bash(aws *)",
      "Bash(stripe *)",
      "Bash(twilio *)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(claude *)",
      "Bash(npx *)",
      "Bash(pnpm dlx *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin master *)",
      "Bash(git commit --no-verify *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh repo delete *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env",
            "args": [
              "CLAUDE_KIT_STATE=${CLAUDE_PROJECT_DIR}/.claude/state",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.py",
              "--log",
              "${CLAUDE_PROJECT_DIR}/.claude/state/hooks.log"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_bootstrap.py",
            "args": [],
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/git_guard.py",
            "args": ["--log", "${CLAUDE_PROJECT_DIR}/.claude/state/hooks.log"],
            "timeout": 20,
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/policy_guard.py",
            "args": [],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/policy_guard.py",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "env",
            "args": [
              "CLAUDE_KIT_STATE=${CLAUDE_PROJECT_DIR}/.claude/state",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/ts_edit_check.py",
              "--log",
              "${CLAUDE_PROJECT_DIR}/.claude/state/hooks.log"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format_on_edit.py",
            "args": [],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree_context.py",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/claim_check.py",
            "args": ["--log", "${CLAUDE_PROJECT_DIR}/.claude/state/hooks.log"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "env",
            "args": [
              "CLAUDE_KIT_STATE=${CLAUDE_PROJECT_DIR}/.claude/state",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_guard.py",
              "--log",
              "${CLAUDE_PROJECT_DIR}/.claude/state/hooks.log"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env",
            "args": [
              "CLAUDE_KIT_STATE=${CLAUDE_PROJECT_DIR}/.claude/state",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stopfailure_checkpoint.py",
              "--log",
              "${CLAUDE_PROJECT_DIR}/.claude/state/hooks.log"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
