{
  "name": "@moin/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "start:api": "node dist/main-api.js",
    "start:voice": "node dist/main-voice.js",
    "start:worker": "node dist/main-worker.js",
    "start:migrate": "node dist/main-migrate.js"
  },
  "dependencies": {
    "@moin/contracts": "workspace:*",
    "@moin/db": "workspace:*",
    "@moin/kernel": "workspace:*",
    "@moin/observability": "workspace:*",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-fastify": "12.1.1",
    "fastify": "5.12.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.1",
    "@types/node": "24.19.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
