@@ -0,0 +1,69 @@
+"""Keep temporary control-plane fixtures bounded independently of live worktrees."""
+
+from __future__ import annotations
+
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import test_control_plane
+
+
+class FixtureCopyTest(unittest.TestCase):
+    def test_copy_excludes_runtime_trees_and_preserves_configuration(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            parent = Path(tmp)
+            source = parent / "source"
+            source.mkdir()
+            (source / "settings.json").write_text("{}")
+            for excluded in ("worktrees", "node_modules", "state", "__pycache__"):
+                directory = source / excluded
+                directory.mkdir()
+                (directory / "do-not-copy").write_text("runtime data")
+            hooks = source / "hooks"
+            hooks.mkdir()
+            (hooks / "guard.py").write_text("# fixture")
+            output = parent / "output"
+            output.mkdir()
+            with patch.object(test_control_plane, "CLAUDE_DIR", source):
+                clone = test_control_plane.clone_control_plane(output)
+            self.assertEqual((clone / ".claude/settings.json").read_text(), "{}")
+            self.assertTrue((clone / ".claude/hooks/guard.py").is_file())
+            for excluded in ("worktrees", "node_modules", "state", "__pycache__"):
+                with self.subTest(excluded=excluded):
+                    self.assertFalse((clone / ".claude" / excluded).exists())
+
+    def test_copy_does_not_follow_directory_symlinks(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            parent = Path(tmp)
+            source = parent / "source"
+            source.mkdir()
+            external = parent / "external"
+            external.mkdir()
+            (external / "payload").write_text("must not be duplicated")
+            (source / "linked-data").symlink_to(external, target_is_directory=True)
+            output = parent / "output"
+            output.mkdir()
+            with patch.object(test_control_plane, "CLAUDE_DIR", source):
+                clone = test_control_plane.clone_control_plane(output)
+            copied_link = clone / ".claude/linked-data"
+            self.assertTrue(copied_link.is_symlink())
+            self.assertEqual(copied_link.readlink(), external)
+
+    def test_failed_setup_cleans_up_its_temporary_directory(self) -> None:
+        with tempfile.TemporaryDirectory() as parent:
+            temporary = tempfile.TemporaryDirectory(dir=parent)
+            path = Path(temporary.name)
+            case = test_control_plane.ControlPlaneCheckTest("test_clean_copy_passes")
+            with (
+                patch.object(test_control_plane, "temp_dir", return_value=temporary),
+                patch.object(test_control_plane, "HAS_PLAN", True),
+                patch.object(
+                    test_control_plane, "clone_control_plane", side_effect=OSError("copy failed")
+                ),
+            ):
+                result = unittest.TestResult()
+                case.run(result)
+            self.assertEqual(len(result.errors), 1)
+            self.assertFalse(path.exists())
