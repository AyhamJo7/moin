+{
+  "_doc": "Autonomous merge policy for .claude/bin/merge_gate.py (CLAUDE.md §8). A session may squash-merge a PR only through that script, which requires: the PR targets `base`; verify-head --ci says VERIFIED for the head SHA; `reviewer` (a GitHub identity separate from the PR author) approved exactly that SHA; no AI-tool mentions in title/body; and no changed file matches `founder_paths`, nor `founder_paths_trial` up to and including `trial_until`. Those PRs stay founder-merged. `reviewer` empty = the gate refuses everything. Patterns are fnmatch globs on repository paths (`*` also matches `/`). founder_paths are permanent: they define the checks and guards that gate this very merge, so an agent must never be able to merge a change to them. founder_paths_trial cover the control paths the founder reviews during the autonomy trial; extend or empty them by editing trial_until.",
+  "reviewer": "",
+  "base": "main",
+  "founder_paths": [
+    ".claude/*",
+    ".github/*",
+    "lefthook.yml",
+    "scripts/check-*",
+    "scripts/policy-regex.ts",
+    "infrastructure/*",
+    "BLUEPRINT.md"
+  ],
+  "founder_paths_trial": [
+    "packages/db/migrations/*",
+    "apps/server/src/modules/identity-access/*",
+    "*billing*",
+    "*usage-ledger*",
+    "*tool-guard*",
+    "*webhook*"
+  ],
+  "trial_until": "2026-11-29"
+}
