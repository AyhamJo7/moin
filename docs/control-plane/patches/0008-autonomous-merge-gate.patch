diff --git a/.claude/bin/merge_gate.py b/.claude/bin/merge_gate.py
new file mode 100644
index 0000000..7079641
--- /dev/null
+++ b/.claude/bin/merge_gate.py
@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+"""merge-gate: squash-merge a pull request when the autonomy conditions hold (CLAUDE.md §8).
+
+Every condition is checked against the PR's current head SHA:
+  ci      `verify-head --pr N --ci --local none --json` says VERIFIED (all required and
+          expected checks passed on that SHA)
+  review  the independent reviewer (policy/merge-gate.json `reviewer`, a GitHub identity other
+          than the PR author) approved exactly that SHA, and that approval is its latest
+          decisive review
+  text    title and body carry no AI-tool mentions (A-22, policy/no-ai-mentions.json)
+  paths   no changed file matches `founder_paths`, nor `founder_paths_trial` until
+          `trial_until`; those PRs stay founder-merged
+  shape   the PR is open and targets `base`
+Then `gh pr ready` (if draft) and `gh pr merge --squash --match-head-commit <sha>`, so a push
+after the check cannot slip in. GitHub's ruleset on main re-checks review and status server-side.
+
+Usage: merge_gate.py <pr-number> [--dry-run]
+Exit: 0 merged (or would merge), 1 refused, 2 usage or tool error.
+"""
+
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import fnmatch
+import json
+import re
+import shutil
+import subprocess
+import sys
+from collections.abc import Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+EXIT_OK, EXIT_REFUSED, EXIT_ERROR = 0, 1, 2
+POLICY_DIR = Path(__file__).resolve().parents[1] / "policy"
+DECISIVE_STATES = frozenset({"APPROVED", "CHANGES_REQUESTED", "DISMISSED"})
+SHOWN_PATHS = 5
+SHA_SHOWN = 10
+GH_TIMEOUT_S = 120
+VERIFY_TIMEOUT_S = 300
+
+
+@dataclass(frozen=True)
+class Policy:
+    reviewer: str
+    base: str
+    founder_paths: tuple[str, ...]
+    founder_paths_trial: tuple[str, ...]
+    trial_until: dt.date
+    ai_patterns: tuple[re.Pattern[str], ...]
+
+
+@dataclass(frozen=True)
+class Review:
+    login: str
+    state: str
+    commit: str
+
+
+class ToolError(Exception):
+    pass
+
+
+def load_policy(directory: Path = POLICY_DIR) -> Policy:
+    gate = json.loads((directory / "merge-gate.json").read_text(encoding="utf-8"))
+    ai = json.loads((directory / "no-ai-mentions.json").read_text(encoding="utf-8"))
+    return Policy(
+        reviewer=str(gate["reviewer"]).strip(),
+        base=str(gate["base"]),
+        founder_paths=tuple(str(g) for g in gate["founder_paths"]),
+        founder_paths_trial=tuple(str(g) for g in gate["founder_paths_trial"]),
+        trial_until=dt.date.fromisoformat(str(gate["trial_until"])),
+        ai_patterns=tuple(re.compile(str(p["regex"])) for p in ai["patterns"]),
+    )
+
+
+def refusals(
+    policy: Policy,
+    pr: dict[str, Any],
+    reviews: Sequence[Review],
+    files: Sequence[str],
+    ci_verdict: str,
+    today: dt.date,
+) -> list[str]:
+    """Every reason the PR may not be merged by a session; empty means it may."""
+    head = str(pr["headRefOid"])
+    author = str((pr.get("author") or {}).get("login", ""))
+    reviewer = policy.reviewer.lower()
+    reasons: list[str] = []
+    if not reviewer:
+        reasons.append("no reviewer identity configured (policy/merge-gate.json `reviewer`)")
+    elif reviewer == author.lower():
+        reasons.append("the PR author is the configured reviewer, so the review is not independent")
+    if pr.get("state") != "OPEN":
+        reasons.append(f"the PR is {pr.get('state')}, not OPEN")
+    if pr.get("baseRefName") != policy.base:
+        reasons.append(f"the PR targets {pr.get('baseRefName')}, not {policy.base}")
+    if ci_verdict != "VERIFIED":
+        reasons.append(f"CI on {head[:SHA_SHOWN]} is {ci_verdict}, not VERIFIED")
+    decisive = [r for r in reviews if r.login.lower() == reviewer and r.state in DECISIVE_STATES]
+    latest = decisive[-1] if decisive else None
+    if reviewer and (latest is None or latest.state != "APPROVED"):
+        state = latest.state if latest else "no review"
+        reasons.append(f"the reviewer's latest decision is {state}, not APPROVED")
+    elif latest is not None and latest.commit != head:
+        reasons.append(
+            f"the reviewer approved {latest.commit[:SHA_SHOWN]}, not the head {head[:SHA_SHOWN]}"
+        )
+    text = f"{pr.get('title') or ''}\n\n{pr.get('body') or ''}"
+    if any(p.search(text) for p in policy.ai_patterns):
+        reasons.append("the title or body mentions an AI tool (A-22)")
+    globs = policy.founder_paths
+    if today <= policy.trial_until:
+        globs += policy.founder_paths_trial
+    held = sorted({f for f in files if any(fnmatch.fnmatchcase(f, g) for g in globs)})
+    if held:
+        more = f" (+{len(held) - SHOWN_PATHS} more)" if len(held) > SHOWN_PATHS else ""
+        reasons.append(f"founder-merged paths changed: {', '.join(held[:SHOWN_PATHS])}{more}")
+    return reasons
+
+
+def run(cmd: Sequence[str], timeout: int = GH_TIMEOUT_S) -> str:
+    proc = subprocess.run(list(cmd), capture_output=True, text=True, timeout=timeout, check=False)
+    if proc.returncode != 0:
+        detail = (proc.stderr or proc.stdout).strip().splitlines()
+        raise ToolError(
+            f"`{' '.join(cmd[:3])}` failed: {detail[-1] if detail else proc.returncode}"
+        )
+    return proc.stdout
+
+
+def fetch_reviews(number: int) -> list[Review]:
+    out = run(
+        [
+            "gh", "api", "--paginate", f"repos/{{owner}}/{{repo}}/pulls/{number}/reviews",
+            "--jq", '.[] | [(.user.login // ""), .state, (.commit_id // "")] | @tsv',
+        ]
+    )  # fmt: skip
+    return [Review(*line.split("\t")) for line in out.splitlines() if line.count("\t") == 2]
+
+
+def fetch_files(number: int) -> list[str]:
+    out = run(
+        [
+            "gh", "api", "--paginate", f"repos/{{owner}}/{{repo}}/pulls/{number}/files",
+            "--jq", ".[] | .filename, (.previous_filename // empty)",
+        ]
+    )  # fmt: skip
+    return [line for line in out.splitlines() if line]
+
+
+def ci_verdict(number: int) -> str:
+    out = run(
+        ["verify-head", "--pr", str(number), "--ci", "--local", "none", "--json"],
+        VERIFY_TIMEOUT_S,
+    )
+    try:
+        return str(json.loads(out)["verdict"])
+    except (ValueError, KeyError) as exc:
+        raise ToolError(f"verify-head returned no verdict: {exc}") from exc
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("pr", type=int)
+    parser.add_argument("--dry-run", action="store_true", help="check only; never merge")
+    args = parser.parse_args(argv)
+    for tool in ("gh", "verify-head"):
+        if shutil.which(tool) is None:
+            print(f"merge-gate: BLOCKED, `{tool}` is not on PATH", file=sys.stderr)
+            return EXIT_ERROR
+    try:
+        policy = load_policy()
+        pr = json.loads(
+            run(
+                [
+                    "gh", "pr", "view", str(args.pr), "--json",
+                    "number,state,isDraft,baseRefName,headRefOid,title,body,author",
+                ]
+            )
+        )  # fmt: skip
+        head = str(pr["headRefOid"])
+        reasons = refusals(
+            policy,
+            pr,
+            fetch_reviews(args.pr),
+            fetch_files(args.pr),
+            ci_verdict(args.pr),
+            dt.datetime.now(dt.UTC).date(),
+        )
+        if reasons:
+            print(f"merge-gate: REFUSED #{args.pr} @ {head[:SHA_SHOWN]}")
+            for reason in reasons:
+                print(f"  - {reason}")
+            return EXIT_REFUSED
+        if args.dry_run:
+            print(f"merge-gate: would merge #{args.pr} @ {head[:SHA_SHOWN]} (dry run)")
+            return EXIT_OK
+        if pr.get("isDraft"):
+            run(["gh", "pr", "ready", str(args.pr)])
+        run(["gh", "pr", "merge", str(args.pr), "--squash", "--match-head-commit", head])
+    except (ToolError, subprocess.TimeoutExpired, OSError, ValueError, KeyError) as exc:
+        print(f"merge-gate: ERROR {exc}", file=sys.stderr)
+        return EXIT_ERROR
+    print(f"merge-gate: MERGED #{args.pr} @ {head[:SHA_SHOWN]} (squash)")
+    return EXIT_OK
+
+
+if __name__ == "__main__":
+    sys.exit(main())
