+"""merge_gate.py: the decision rules, the shipped policy, and the gh / verify-head plumbing."""
+
+from __future__ import annotations
+
+import dataclasses
+import datetime as dt
+import json
+import os
+import shutil
+import stat
+import sys
+import unittest
+from pathlib import Path
+from typing import Any
+
+from helpers import BIN, CLAUDE_DIR, base_env, run, temp_dir, write
+
+sys.path.insert(0, str(BIN))
+import merge_gate
+from merge_gate import Review
+
+HEAD = "a" * 40
+OLD = "b" * 40
+BOT = "moin-review-bot"
+TODAY = dt.date(2026, 11, 2)
+
+
+def policy(**changes: Any) -> merge_gate.Policy:
+    base = dataclasses.replace(merge_gate.load_policy(), reviewer=BOT, trial_until=TODAY)
+    return dataclasses.replace(base, **changes)
+
+
+def pr(**changes: Any) -> dict[str, Any]:
+    data: dict[str, Any] = {
+        "number": 7,
+        "state": "OPEN",
+        "isDraft": True,
+        "baseRefName": "main",
+        "headRefOid": HEAD,
+        "title": "feat(p13): show the callback reason",
+        "body": "Adds the reason to the card.",
+        "author": {"login": "AyhamJo7"},
+    }
+    data.update(changes)
+    return data
+
+
+APPROVED = [Review(BOT, "APPROVED", HEAD)]
+FILES = ["apps/web/src/today/card.tsx"]
+
+
+class RefusalsTest(unittest.TestCase):
+    def check(self, **kw: Any) -> list[str]:
+        args: dict[str, Any] = {
+            "policy": policy(),
+            "pr": pr(),
+            "reviews": APPROVED,
+            "files": FILES,
+            "ci_verdict": "VERIFIED",
+            "today": TODAY,
+        }
+        args.update(kw)
+        return merge_gate.refusals(**args)
+
+    def assert_refused(self, fragment: str, **kw: Any) -> None:
+        reasons = self.check(**kw)
+        self.assertTrue(any(fragment in r for r in reasons), reasons)
+
+    def test_all_conditions_met_merges(self) -> None:
+        self.assertEqual(self.check(), [])
+
+    def test_ci_not_verified(self) -> None:
+        for verdict in ("FAILED", "PENDING"):
+            self.assert_refused("not VERIFIED", ci_verdict=verdict)
+
+    def test_no_reviewer_configured_refuses_everything(self) -> None:
+        self.assert_refused("no reviewer identity", policy=policy(reviewer=""))
+
+    def test_author_cannot_be_the_reviewer(self) -> None:
+        self.assert_refused("not independent", pr=pr(author={"login": BOT.upper()}))
+
+    def test_missing_or_stale_or_superseded_approval(self) -> None:
+        self.assert_refused("no review", reviews=[])
+        self.assert_refused("no review", reviews=[Review("someone-else", "APPROVED", HEAD)])
+        self.assert_refused("not the head", reviews=[Review(BOT, "APPROVED", OLD)])
+        later = [*APPROVED, Review(BOT, "CHANGES_REQUESTED", HEAD)]
+        self.assert_refused("CHANGES_REQUESTED", reviews=later)
+        self.assert_refused("DISMISSED", reviews=[*APPROVED, Review(BOT, "DISMISSED", HEAD)])
+
+    def test_comments_after_approval_do_not_revoke_it(self) -> None:
+        self.assertEqual(self.check(reviews=[*APPROVED, Review(BOT, "COMMENTED", HEAD)]), [])
+
+    def test_shape(self) -> None:
+        self.assert_refused("not OPEN", pr=pr(state="MERGED"))
+        self.assert_refused("not main", pr=pr(baseRefName="release"))
+
+    def test_ai_mention_in_text(self) -> None:
+        self.assert_refused("A-22", pr=pr(body="Co-Authored-By: x <x@example.com>"))
+
+    def test_permanent_founder_paths(self) -> None:
+        later = dt.date(2030, 1, 1)
+        for path in (
+            ".github/workflows/verify.yml",
+            ".claude/policy/merge-gate.json",
+            "scripts/check-rls-catalog.ts",
+            "lefthook.yml",
+            "infrastructure/envs/prod/main.tf",
+        ):
+            with self.subTest(path=path):
+                self.assert_refused("founder-merged", files=[*FILES, path], today=later)
+
+    def test_trial_paths_until_the_date(self) -> None:
+        path = "packages/db/migrations/0040_roles.sql"
+        self.assert_refused("founder-merged", files=[path], today=TODAY)
+        self.assertEqual(self.check(files=[path], today=TODAY + dt.timedelta(days=1)), [])
+
+
+class ShippedPolicyTest(unittest.TestCase):
+    def test_policy_loads_and_ships_closed(self) -> None:
+        shipped = merge_gate.load_policy()
+        self.assertEqual(shipped.base, "main")
+        self.assertIn(".github/*", shipped.founder_paths)
+        self.assertIn(".claude/*", shipped.founder_paths)
+        self.assertTrue(shipped.ai_patterns)
+
+
+FAKE_GH = """#!/usr/bin/env python3
+import json, os, sys
+from pathlib import Path
+state = Path(os.environ["FAKE_TOOL_DIR"])
+args = sys.argv[1:]
+with (state / "calls.log").open("a") as f:
+    f.write(json.dumps(args) + "\\n")
+fx = json.loads((state / "fixture.json").read_text())
+if args[:2] == ["pr", "view"]:
+    print(json.dumps(fx["pr"]))
+elif args[:1] == ["api"] and args[2].endswith("/reviews"):
+    print("\\n".join("\\t".join(r) for r in fx["reviews"]))
+elif args[:1] == ["api"] and args[2].endswith("/files"):
+    print("\\n".join(fx["files"]))
+elif args[:2] not in (["pr", "ready"], ["pr", "merge"]):
+    sys.exit(1)
+"""
+FAKE_VERIFY = """#!/usr/bin/env python3
+import json, os
+from pathlib import Path
+fx = json.loads((Path(os.environ["FAKE_TOOL_DIR"]) / "fixture.json").read_text())
+print(json.dumps({"verdict": fx["ci"]}))
+"""
+
+
+class CommandLineTest(unittest.TestCase):
+    """Runs a copy of the script (its policy beside it) against fake gh and verify-head."""
+
+    def invoke(self, fixture: dict[str, Any], *extra: str) -> tuple[int, str, list[list[str]]]:
+        with temp_dir() as tmp:
+            root = Path(tmp)
+            shutil.copy(BIN / "merge_gate.py", write(root, ".claude/bin/merge_gate.py", ""))
+            gate = json.loads((CLAUDE_DIR / "policy/merge-gate.json").read_text(encoding="utf-8"))
+            gate.update(reviewer=BOT, trial_until="2000-01-01")
+            write(root, ".claude/policy/merge-gate.json", json.dumps(gate))
+            shutil.copy(CLAUDE_DIR / "policy/no-ai-mentions.json", root / ".claude/policy")
+            for name, body in (("gh", FAKE_GH), ("verify-head", FAKE_VERIFY)):
+                tool = write(root, f"bin/{name}", body)
+                tool.chmod(tool.stat().st_mode | stat.S_IXUSR)
+            write(root, "fixture.json", json.dumps(fixture))
+            env = base_env(
+                FAKE_TOOL_DIR=str(root), PATH=f"{root / 'bin'}{os.pathsep}{os.environ['PATH']}"
+            )
+            proc = run(root / ".claude/bin/merge_gate.py", ["7", *extra], env=env)
+            log = root / "calls.log"
+            calls = [json.loads(x) for x in log.read_text().splitlines()] if log.exists() else []
+            return proc.returncode, proc.stdout + proc.stderr, calls
+
+    @staticmethod
+    def fixture(**changes: Any) -> dict[str, Any]:
+        data: dict[str, Any] = {
+            "pr": pr(),
+            "reviews": [[BOT, "APPROVED", HEAD]],
+            "files": FILES,
+            "ci": "VERIFIED",
+        }
+        data.update(changes)
+        return data
+
+    def test_merges_the_checked_head_only(self) -> None:
+        code, out, calls = self.invoke(self.fixture())
+        self.assertEqual(code, merge_gate.EXIT_OK, out)
+        self.assertIn(["pr", "ready", "7"], calls)
+        self.assertEqual(calls[-1], ["pr", "merge", "7", "--squash", "--match-head-commit", HEAD])
+
+    def test_refusal_never_merges(self) -> None:
+        code, out, calls = self.invoke(self.fixture(ci="FAILED"))
+        self.assertEqual(code, merge_gate.EXIT_REFUSED, out)
+        self.assertIn("not VERIFIED", out)
+        self.assertFalse([c for c in calls if c[:2] in (["pr", "merge"], ["pr", "ready"])])
+
+    def test_dry_run_never_merges(self) -> None:
+        code, out, calls = self.invoke(self.fixture(), "--dry-run")
+        self.assertEqual(code, merge_gate.EXIT_OK, out)
+        self.assertIn("would merge", out)
+        self.assertFalse([c for c in calls if c[:2] == ["pr", "merge"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
