{
  "realm": "moin-local",
  "enabled": true,
  "displayName": "moin (local development)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": true,
  "clients": [
    {
      "clientId": "moin-web",
      "name": "moin owner app (local)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-development-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": ["basic", "email"],
      "optionalClientScopes": []
    },
    {
      "clientId": "moin-tests",
      "name": "integration tests (local)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-development-only",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["basic", "email"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "inhaber@musterrestaurant.example",
      "email": "inhaber@musterrestaurant.example",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Maria",
      "lastName": "Mustermann",
      "credentials": [
        {
          "type": "password",
          "value": "local-development-only",
          "temporary": false
        }
      ]
    },
    {
      "username": "mitarbeiter@musterbetrieb-shk.example",
      "email": "mitarbeiter@musterbetrieb-shk.example",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Jonas",
      "lastName": "Beispiel",
      "credentials": [
        {
          "type": "password",
          "value": "local-development-only",
          "temporary": false
        }
      ]
    }
  ]
}
